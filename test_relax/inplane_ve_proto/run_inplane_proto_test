#!/bin/bash
#
# run_inplane_proto_test: gate suite for the standalone PLANE-STRAIN
# (in-plane / dip-slip / thrust cross section) viscoelastic kernel
# prototype.  See README_inplane_ve_proto.md.  All gates must PASS.
#
#   T0: analytic basis / ODE / source-jump / matcher exactness
#   T1: elastic anchors (interact Okada, tight; FEM, soft)
#   T2: uniform-Maxwell correspondence, sympy-exact time factor
#   T3: elastic plate over Maxwell substrate: unrelaxed and relaxed
#       limits, interface traction continuity in time, monotonicity
#   T4: gravity (advected-boundary buoyancy): elastic insensitivity,
#       relaxed buoyant-flexure limit, through-plate mode suppression
#   T5: LITERATURE, viscoelastic thrust-fault relaxation with and
#       without gravity vs Rundle (JGR 1982) Figs. 2/3, incl. the
#       buoyancy suppression of the relaxed basin
#       (rundle_relax_test.py; also writes rundle_relax_test.png)
#   T6: Maxwell-time scaling, dK(t; tau) = dKtilde(t/tau), the
#       symmetry bp3_ve_kernels.py uses to emit one kernel file per
#       Maxwell time from a single sampling pass (file-level check:
#       run_tau_scaling_test)
#   T7: the batched matched-pair evaluation path (the production
#       kernel-generation path) against the original per-wavenumber
#       loop, kept as fields_pairs_ref, and against the diagonal of
#       the untouched fields_xz
#
# Optional, run separately (needs PSGRN/PSCMP built, see
# tools/psgrn/install_psgrn):
#   psgrn_compare.py <psgrn_run_dir> plot   cross-validation against
#       Wang's PSGRN/PSCMP (1-3 percent of peak, gravity on and off)
#
sdir=`dirname $0`
cd $sdir
fail=0
for t in t0_basis.py t1_elastic.py t2_maxwell_corr.py t3_plate_maxwell.py t4_gravity.py rundle_relax_test.py t6_tau_scaling.py t7_batched_fields.py;do
    echo "=== $t"
    python3 $t || fail=1
done
[ $fail -eq 0 ] && echo "run_inplane_proto_test: ALL GATES PASS" || \
    echo "run_inplane_proto_test: FAILURES (see above)"
exit $fail
