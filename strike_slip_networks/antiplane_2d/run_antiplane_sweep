#!/bin/bash
#
# run_antiplane_sweep [rundir] [ncycles] [laws]: the original single
# parameter scans at the paper values of a/b (Wu & Chen model A, W/hc 3 to
# 120; Cattania, W/L_inf 3.2 to 26); completed runs are skipped
#
rundir=${1-.}
ncyc=${2-40}
laws=${3-"aging slip"}
sdir=$(cd "$(dirname "$0")" && pwd)
mkdir -p "$rundir"
cd "$rundir" || exit 1
done_run () { tail -1 $1/rsf_solve.log 2>/dev/null | grep -q "^wall"; }
for law in $laws; do
    for X in 3 8.6 20 31.5 63; do
        done_run wuchen_${law}_X$X || "$sdir/run_antiplane" wuchen $X $law $ncyc 8 0 wuchen_${law}_X$X
    done
    for X in 3.2 6.5 13; do
        done_run cattania_${law}_X$X || "$sdir/run_antiplane" cattania $X $law $ncyc 4 0 cattania_${law}_X$X
    done
done
for law in $laws; do
    done_run wuchen_${law}_X120 || "$sdir/run_antiplane" wuchen 120 $law $ncyc 4 0 wuchen_${law}_X120
    done_run cattania_${law}_X26 || "$sdir/run_antiplane" cattania 26 $law $ncyc 4 0 cattania_${law}_X26
done
echo SWEEP_DONE
