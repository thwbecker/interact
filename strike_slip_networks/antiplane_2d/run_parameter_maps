#!/bin/bash
#
# run_parameter_maps [rundir] [laws] [ncycles] [maxcells]: two-parameter
# scans for maps analogous to Wu & Chen (2014, W/hc against b/a) and
# Cattania (2019, W/L_inf against a/b), for each state evolution law;
# cells L_b/4; runs whose fault would need more than maxcells cells are
# skipped; completed runs are skipped, so the script can be restarted
#
rundir=${1-.}
laws=${2-"aging slip"}
ncyc=${3-30}
maxcells=${4-700}
sdir=$(cd "$(dirname "$0")" && pwd)
mkdir -p "$rundir"
cd "$rundir" || exit 1
done_run () { tail -1 $1/rsf_solve.log 2>/dev/null | grep -q "^wall"; }
ncells () { python3 "$sdir/gen_antiplane.py" $1 $2 --a_over_b $3 --cpl 4 --out /tmp/ncells_$$ | \
                awk '{for(i=1;i<=NF;i++) if($i=="VW") v=$(i-1); else if($i=="VS") s=$(i-1)} END{print v+s}'; }
wuchen_scan () {
    for X in $1; do
        for law in $laws; do
            for aob in 0.75 0.5 0.333; do          # b/a = 1.33, 2, 3
                n=wuchen_${law}_ab${aob}_X$X
                done_run $n && continue
                [ $(ncells wuchen $X $aob) -gt $maxcells ] && continue
                "$sdir/run_antiplane" wuchen $X $law $ncyc 4 $aob $n
            done
        done
    done
}
# cheapest first: small faults of both setups, then the large Wu & Chen ones
wuchen_scan "2 5 11 22"
for X in 2 4 8 16 32; do
    for law in $laws; do
        for aob in 0.5 0.625 0.75 0.875; do
            n=cattania_${law}_ab${aob}_X$X
            done_run $n && continue
            [ $(ncells cattania $X $aob) -gt $maxcells ] && continue
            "$sdir/run_antiplane" cattania $X $law $ncyc 4 $aob $n
        done
    done
done
wuchen_scan "45 90"
rm -rf /tmp/ncells_$$
echo MAPS_DONE
