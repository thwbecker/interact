set term post land enh color solid 'Palatino-Roman,18'
set out 'uphoff.ps'

set multi
set size 1,.5
set origin 0,.5
set xlabel 'time [yr]'
set ylabel 'log_{10}(v [m/s])'
set title 'with normal stress change'
set key outside
plot 'run_sigma/rsf_monitor.g000.dat' using 3 : 5 title 'M' w l lw 2,\
     'run_sigma/rsf_monitor.g001.dat' using 3 : 5 title 'S1' w l,\
     'run_sigma/rsf_monitor.g002.dat' using 3 : 5 title 'S2' w l,\
     'run_sigma/rsf_monitor.g003.dat' using 3 : 5 title 'S3' w l,\
     'run_sigma/rsf_monitor.g004.dat' using 3 : 5 title 'S4' w l

set origin 0,0
set title 'no normal stress change'
plot 'run_nosigma/rsf_monitor.g000.dat' using 3 : 5 title 'M' w l lw 2,\
     'run_nosigma/rsf_monitor.g001.dat' using 3 : 5 title 'S1' w l,\
     'run_nosigma/rsf_monitor.g002.dat' using 3 : 5 title 'S2' w l,\
     'run_nosigma/rsf_monitor.g003.dat' using 3 : 5 title 'S3' w l,\
     'run_nosigma/rsf_monitor.g004.dat' using 3 : 5 title 'S4' w l


!modifybb uphoff.ps 1