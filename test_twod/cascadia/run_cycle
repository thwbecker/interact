#!/bin/bash
#
# Quasi-dynamic seismic cycle on one of the six Cascadia run directories
# that prepare_files builds:
#
#   PD06_nosigma  PD07_nosigma  PD13_nosigma    sigma held fixed
#   PD06_sigma    PD07_sigma    PD13_sigma      sigma evolving
#
# Run it from this directory with the run directory as the argument:
#   ./run_cycle PD06_nosigma
#   ./run_cycle PD06_sigma
#
# The per-patch input files are identical in the two variants of a
# section, so the only difference between the paired catalogs is whether
# -calc_sigma_dot is on.  Run the nosigma variant first: with it off the
# friction law is odd in (tau, v) and a sign error in the initial
# condition shows up as a slow monotonic drift rather than as wrong
# physics, and it is the cheaper of the two since no In matrix is built.
#
# On this thrust geometry the sigma variant is expected to CLAMP the
# splays, since megathrust slip in the thrust sense raises normal stress
# on the hanging wall.  That is the opposite of the Uphoff normal-fault
# case, where sigma coupling unclamped the splays and promoted activity.
# Whether the triggered splay episodes survive it is the thing worth
# comparing between the two catalogs.
#
# Everything else matches the Uphoff production runs, so those results
# stay comparable.  All parameters are plain assignments below; no
# environment variables.

set -e

rundir=${1:-PD06_nosigma}
nproc=$NR_CPUS

section=${rundir%_*}                # PD06, PD07 or PD13
variant=${rundir##*_}               # nosigma or sigma
geom=geom_$section.in

shear_modulus=3.0e10        # must match rsf_input_gen_cascadia.py, which used
                            # it for the h* census
s_wave_speed=3464
f0=0.6                      # must match rsf_input_gen_cascadia.py
v0=1e-6                     # must match rsf_input_gen_cascadia.py
vpl=1.2e-9                  # thrust sense; rsf_vpl.in carries the per-patch
                            # values and this only sets the slip-budget
                            # reference
state_law=1                 # aging
rk_type=3bs
rtol=1e-5
vel_event=1e-3
rupture_vth=1e-3
stop_time_yr=5000
max_steps=50000000
checkpoint_every=50000

min_sigma=1e6               # limiter floor [Pa], sigma variant only.  The
                            # background runs 5.9 to 50 MPa, so the shallowest
                            # patches start only a factor of six above this
                            # floor; watch the min_sigma[Pa] column of
                            # rsf_monitor.dat, and if it sits on the floor for
                            # long stretches the result is telling you about
                            # the limiter rather than about the physics
max_sigma=200e6             # limiter ceiling [Pa]

if [ ! -d $rundir ]; then
    echo "$0: no such run directory: $rundir (run ./prepare_files first)" 1>&2
    exit 1
fi

sigma_flags=""
if [ "$variant" = "sigma" ]; then
    sigma_flags="-calc_sigma_dot -limit_sigma -min_sigma $min_sigma -max_sigma $max_sigma"
elif [ "$variant" != "nosigma" ]; then
    echo "$0: $rundir does not end in _nosigma or _sigma" 1>&2
    exit 1
fi
hmat_flags="-use_hmatrix 4 -hmmvp_tol 1e-4"
#hmat_flags=""


cd $rundir

mpirun -bind-to core -np $nproc \
       rsf_solve -geom_file $geom \
       -rsf_file rsf_ab.in -rsf_dc_file rsf_dc.in \
       -rsf_sigma_file rsf_sigma.in -rsf_vpl_file rsf_vpl.in \
       -rsf_ic_file rsf_ic.in \
       -state_law $state_law $hmat_flags \
       -shear_modulus $shear_modulus -s_wave_speed $s_wave_speed \
       -f0 $f0 -v0 $v0 -vpl $vpl \
       -rsf_catalog -vel_event $vel_event -rupture_vth $rupture_vth \
       -rsf_monitor_by_group \
       $sigma_flags \
       -ts_rk_type $rk_type -rtol $rtol \
       -stop_time_yr $stop_time_yr -ts_max_steps $max_steps \
       -rsf_checkpoint $checkpoint_every
