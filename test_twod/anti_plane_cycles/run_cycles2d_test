#!/bin/bash
#
# gating test for the 2-D antiplane cycle experiment suite (about 2-3
# minutes).  See README_cycles2d.md for the experiment recipes this
# machinery supports.
#
# Gates:
#  (1) SEAS BP1-QD community anchor (Erickson et al., SRL 2020), coarse
#      200-m cells: second recurrence interval within [75.7, 78.7] yr
#      (community-converged value 78.2; our series 77.88/78.21/78.24/
#      78.19 at 200/100/50/25 m)
#  (2) resolution convergence: 100-m vs 200-m second interval within
#      1 percent (the RSF discretization criteria are satisfied with
#      margin: BP1 Lb/3 = 114 m, and even 200 m is only 0.45 percent
#      off the converged value)
#  (3) viscoelastic single-fault regression (bp5 profile, D = 20 km
#      fault in an H = 22 km plate, tM = 5 yr, spun memory): steady
#      recurrence 253.5 +- 1.5 yr, i.e. LONGER than the elastic 250.9
#      +- 1.0 (contained faults over a shallow substrate lengthen
#      mildly; the pre-fix machinery gave shortening here, see
#      README_ve_antiplane.md)
#  (4) two-fault elastic smoke test: both faults produce events, and
#      velocity AND stress field frames exist for both groups
#
bindir=`cd ../../bin && pwd`
sdir=`pwd`
fail=0

# ---- (1,2) BP1-QD anchor and resolution -------------------------------------
rm -rf tmp_bp1a tmp_bp1b
# the BP1 uniform IC nucleates its first event near t = 198 yr; run to
# 360 yr to capture two intervals and gate on the second
NOPLOT=1 ./run_cycles2d bp1 0.2 40 1 10 0 60 360 tmp_bp1a > /dev/null 2>&1
NOPLOT=1 ./run_cycles2d bp1 0.1 40 1 10 0 60 360 tmp_bp1b > /dev/null 2>&1
i2a=`grep -v '^#' tmp_bp1a/rsf_catalog.g000.dat | awk '$6>3{if(t)print $2-t; t=$2}' | sed -n 2p`
i2b=`grep -v '^#' tmp_bp1b/rsf_catalog.g000.dat | awk '$6>3{if(t)print $2-t; t=$2}' | sed -n 2p`
ok=`echo $i2a | awk '{print ($1>75.7 && $1<78.7)?1:0}'`
if [ "$ok" = "1" ];then
    echo "$0: (1) BP1-QD anchor (200 m): interval $i2a yr (SEAS converged 78.2): PASS"
else
    echo "$0: (1) BP1-QD anchor (200 m): interval '$i2a' yr outside [75.7,78.7]: FAIL"; fail=1
fi
ok=`echo $i2a $i2b | awk '{d=($2-$1)/$2; if(d<0)d=-d; print (d<0.01)?1:0}'`
if [ "$ok" = "1" ];then
    echo "$0: (2) resolution: 100 m gives $i2b yr, within 1% of 200 m: PASS"
else
    echo "$0: (2) resolution: 200 m $i2a vs 100 m $i2b yr: FAIL"; fail=1
fi

# ---- (3) VE single-fault regression ------------------------------------------
rm -rf tmp_vs tmp_es
NOPLOT=1 ./run_cycles2d bp5 0.5 20 1 10 5 22 1100 tmp_vs -dc 0.08 > /dev/null 2>&1
NOPLOT=1 ./run_cycles2d bp5 0.5 20 1 10 0 22 800  tmp_es -dc 0.08 > /dev/null 2>&1
ive=`grep -v '^#' tmp_vs/rsf_catalog.g000.dat | awk '$6>3{if(t)d=$2-t; t=$2} END{print d}'`
iel=`grep -v '^#' tmp_es/rsf_catalog.g000.dat | awk '$6>3{if(t)d=$2-t; t=$2} END{print d}'`
ok=`echo $ive $iel | awk '{print ($1>252.0 && $1<255.0 && $2>249.9 && $2<251.9 && $1>$2)?1:0}'`
if [ "$ok" = "1" ];then
    echo "$0: (3) VE regression: elastic $iel, VE(tM=5, H=22) $ive yr (mild lengthening): PASS"
else
    echo "$0: (3) VE regression: elastic '$iel', VE '$ive' yr: FAIL"; fail=1
fi

# ---- (4) two-fault smoke ------------------------------------------------------
rm -rf tmp_2f
NOPLOT=1 ./run_cycles2d bp5 0.5 20 2 10 0 22 600 tmp_2f -dc 0.08 > /dev/null 2>&1
n0=`grep -vc '^#' tmp_2f/rsf_catalog.g000.dat 2>/dev/null`
n1=`grep -vc '^#' tmp_2f/rsf_catalog.g001.dat 2>/dev/null`
nv=`ls tmp_2f/tmp_rsf/rsf_vel.g001.*.bin 2>/dev/null | wc -l`
nt=`ls tmp_2f/tmp_rsf/rsf_tau.g001.*.bin 2>/dev/null | wc -l`
if [ "$n0" -ge 2 ] && [ "$n1" -ge 2 ] && [ "$nv" -ge 5 ] && [ "$nv" = "$nt" ];then
    echo "$0: (4) two-fault smoke: events on both faults ($n0/$n1), $nv vel + $nt tau frames: PASS"
else
    echo "$0: (4) two-fault smoke: events $n0/$n1, frames $nv/$nt: FAIL"; fail=1
fi
python3 $sdir/plot_cycles2d.py tmp_2f > /dev/null 2>&1 && \
    echo "$0: figures render (see tmp_2f/*.png)" || { echo "$0: plotting FAILED"; fail=1; }

if [ $fail -eq 0 ];then
    echo "$0: all gates PASS"
else
    echo "$0: FAILURES, see above"; exit 1
fi
