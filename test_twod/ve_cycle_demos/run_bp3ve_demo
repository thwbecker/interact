#!/bin/bash
#
# run_bp3ve_demo: viscoelastic earthquake cycles on a DIPPING
# (in-plane, plane-strain) fault with rsf_solve -ve_mode 3: the
# BP3 dip-60 geometry contained in an elastic plate (H = 40 km) over
# a Maxwell half-space, with gravity, external kernels generated by
# test_relax/inplane_ve_proto/bp3_ve_kernels.py and fed through
# -ve_prony_file.
#
# BOTH TRACTION COMPONENTS BY DEFAULT: on a dipping fault slip
# changes the fault-normal traction as well as the shear traction,
# and when the substrate relaxes both evolve.  The kernel files
# therefore carry two traction families and the runs use
# -calc_sigma_dot, so sigma_n is elastic PLUS hereditary; the
# elastic reference gets -calc_sigma_dot too, so the comparison is
# like for like.  Pass sigma=0 for the older behaviour (frozen
# sigma_n, shear-only kernels), which is worth running once: the
# SIGN of the viscoelastic effect on recurrence depends on it, see
# test_relax/inplane_ve_proto/README_inplane_ve_proto.md.
#
# Each run also writes the 12 SEAS station time series, kept per
# case in st_el/ and st_tm<tM>/ (t, slip, log10 V, tau, sigma_n,
# log10 theta), so the normal-stress history can be plotted with
# ../../seas_bp_tests/bp3/plot_bp3.py.  The catalog, event list and
# monitor are kept per case too, as cat_<tag>.dat, ev_<tag>.dat and
# mon_<tag>.dat: rsf_solve writes the same three file names for every
# run, so without the copies only the last case of a sweep survives.
#
# Re-running with a LONGER -stop_time_yr extends each case from its
# own checkpoint rather than doing nothing; see run_case below.
#
# Physics: contained-fault loading-pathway relaxation, the
# Rundle/Thatcher-Rundle regime, cf. the antiplane loading-condition
# map in test_twod/anti_plane/ve_loading_conditions.md.
#
# Demonstration resolution (default ds = 667 m; NOT converged BP3,
# the point is the elastic-vs-VE contrast at fixed mesh).  Kernel
# generation takes about a minute and caches/resumes; only the FIRST Maxwell
# time in the list pays it, because the sampled kernels depend on
# t/tau rather than on tau (bp3_ve_kernels.py, "MAXWELL-TIME
# SCALING"), so the rest are a fit and a file write.  The cache is
# shared by every Maxwell time in the run directory.
#
# usage: run_bp3ve_demo [outdir] [tmlist_yr] [stop_yr] [sigma] [ds_km]
#                       [gravity] [extra rsf_solve options] [ncore]
#                       [branch]
#        branch +1 (default) NORMAL-sense or -1 THRUST.  It sets the
#              sign of vpl and of the initial conditions together, so
#              the two cannot disagree; see gen_bp3.py, "BRANCH".  The
#              branch is stamped into the run directory and a later
#              call with the other one is refused, since catalogs from
#              the two are not comparable.
#        ncore: cores for KERNEL GENERATION, which dominates the cost
#              (trivially parallel over source columns; the cycle runs
#              themselves are seconds to minutes and single core)
#        defaults  bp3ve_demo "15 30 45 75 120 200 400" 1500 1 0.6667 1 "" 1 1
#        extra: passed through to rsf_solve, e.g. "-imex" (needed at
#              fine resolution with sigma coupling: explicit RK can
#              hit domain-check rejection storms during large events)
#        sigma 1 (default): shear + normal tractions (-calc_sigma_dot
#              plus two-family kernels); 0: shear only, sigma frozen
#        gravity 1 (default) / 0: buoyancy in the kernels; use
#              SEPARATE output directories for the two cases
#        (kernels cost about a minute for the first tM and
#         seconds for each further one, cached in the run dir)
#
bindir=`cd ../../bin && pwd`
sdir=`pwd`
proto=`cd ../../test_relax/inplane_ve_proto && pwd`
dir=${1-bp3ve_demo}
tmlist=${2-"15 30 45 75 120 200 400"}
stop=${3-1500}
sigma=${4-1}
ds=${5-0.6667}
grav=${6-1}
extra=${7-}			# extra rsf_solve options, e.g. "-imex"
ncore=${8-1}			# cores for KERNEL GENERATION (the slow part)
branch=${9-1}			# +1 normal-sense, -1 thrust
case "$branch" in
    1|+1) vpl=1e-9;  bname=NORMAL ;;
    -1)   vpl=-1e-9; bname=THRUST ;;
    *) echo "$0: branch must be +1 (normal) or -1 (thrust)"; exit 1 ;;
esac
echo "$0: $bname branch (vpl $vpl)"
if [ "$sigma" = "1" ];then
    sigopt="-calc_sigma_dot"; nrm=1
    echo "$0: shear + normal tractions (two-family kernels)"
else
    sigopt=""; nrm=0
    echo "$0: shear only, sigma_n frozen"
fi
[ "$grav" = "1" ] && echo "$0: gravity ON (rho 2800/3300, 9.81)" || \
    echo "$0: gravity OFF"
# kernels depend on tM AND on the gravity setting, so the file name
# carries both: a run never picks up a stale file from the other case
ktag=g${grav}n$nrm	# kernels depend on gravity AND family count
mkdir -p $dir && cd $dir
# the branch is a property of the whole directory: the elastic
# reference and the viscoelastic runs are only comparable within one
if [ -f branch.txt ] && [ "`cat branch.txt`" != "$branch" ];then
    echo "$0: $dir holds the `cat branch.txt` branch, refusing to add $branch"
    exit 1
fi
echo $branch > branch.txt
python3 $sdir/../../seas_bp_tests/bp3/gen_bp3.py $ds 60 bp3 $branch > gen.log
common="-geom_file bp3_geom.in -rsf_file bp3_rsf.dat -rsf_ic_file bp3_ic.in \
 -dc 0.008 -sigma_init 5e7 -f0 0.6 -v0 1e-6 -vpl $vpl \
 -shear_modulus 3.204e10 -s_wave_speed 3464 -rtol 1e-4 -ts_rk_type 3bs \
 -ts_max_steps 2000000000 -dt_monitor_yr 10 -track_events -rsf_catalog \
 -vel_event 1e-3 -rsf_checkpoint 20000 -rsf_checkpoint_wall 60 \
 -rsf_stations bp3_stations.dat -rsf_station_dt_yr 0.5 \
 -stop_time_yr $stop $sigopt $extra"
# One case: the elastic reference (tag el) or one Maxwell time (tag
# tm<tM>).  A case counts as done only if it was run to at least the
# CURRENTLY requested stop time, which is recorded in stop_<tag>.yr.
# A later call with a longer -stop_time_yr therefore extends the case
# from its own checkpoint instead of silently doing nothing, which is
# what a bare "does cat_<tag>.dat exist" test did.  rsf_solve opens
# its outputs in append mode on restart and writes a "# restarted"
# line, so the catalog, events, monitor and station series of the
# extended run continue the old ones; they are staged back into place
# before the restart for that reason.
#
# Checkpoints are per case.  rsf_solve refuses to restart an elastic
# run from a viscoelastic checkpoint and the reverse, but nothing
# would catch restarting tM = 30 yr from a tM = 15 yr checkpoint, and
# a single shared rsf_checkpoint.bin invited exactly that.
run_case ()
{
    tag=$1; shift
    cat=cat_$tag.dat; stamp=stop_$tag.yr; ck=ckpt_$tag.bin
    have=0
    [ -f "$stamp" ] && have=`cat $stamp`
    if awk -v a="$have" -v b="$stop" 'BEGIN{exit !(a+0 >= b+0)}';then
	echo "$0: $tag already run to $have yr, at or past $stop, skipping"
	return 0
    fi
    rm -f rsf_catalog* rsf_events.dat rsf_monitor* fltst_*.dat
    # the run writes its checkpoint to a SCRATCH name and it is
    # committed only together with the catalog.  Otherwise an
    # interrupted extension leaves a checkpoint ahead of the saved
    # catalog, and the next attempt restarts from there and silently
    # drops the events in between.
    [ -f "$ck.run" ] && echo "$0: $tag: discarding an interrupted"\
	"extension (checkpoint $ck.run)"
    rm -f $ck.run $ck.run.prev $ck.run.info
    rst=
    if [ -f "$ck" ] && [ -f "$cat" ];then
	echo "$0: extending $tag from $have to $stop yr"
	cp $cat rsf_catalog.dat
	[ -f ev_$tag.dat ] && cp ev_$tag.dat rsf_events.dat
	[ -f mon_$tag.dat ] && cp mon_$tag.dat rsf_monitor.dat
	[ -d st_$tag ] && cp st_$tag/fltst_*.dat . 2>/dev/null
	rst="-rsf_restart $ck"
    else
	echo "$0: $tag from scratch to $stop yr"
	rm -f $ck $ck.prev $ck.info
	: > run_$tag.log
    fi
    $bindir/rsf_solve $common -rsf_checkpoint_file $ck.run $rst "$@" \
	>> run_$tag.log 2>&1 || {
	echo "$0: $tag FAILED, see $dir/run_$tag.log"; return 1; }
    cp rsf_catalog.dat $cat
    [ -f rsf_events.dat ] && cp rsf_events.dat ev_$tag.dat
    [ -f rsf_monitor.dat ] && cp rsf_monitor.dat mon_$tag.dat
    mkdir -p st_$tag && mv fltst_*.dat st_$tag/ 2>/dev/null
    if [ -f "$ck.run" ];then                 # commit, with the catalog
	mv $ck.run $ck
	[ -f $ck.run.info ] && mv $ck.run.info $ck.info
	rm -f $ck.run.prev
    fi
    echo $stop > $stamp
    return 0
}
run_case el || exit 1
for tm in $tmlist;do
    if [ ! -f bp3_tm${tm}_$ktag.prony ];then
	echo "$0: generating kernels for tM = $tm yr on $ncore core(s), resumable"
	dd=`pwd`
	(cd $proto && ./bp3_ve_kernels_par $dd/bp3_geom.in 40e3 $tm \
	    $dd/bp3_tm${tm}_$ktag.prony $ncore 5 -1 $grav $nrm) || exit 1
    fi
    run_case tm$tm -ve_mode 3 -ve_prony_file bp3_tm${tm}_$ktag.prony \
	-ve_h_init 1 || exit 1
done
python3 $sdir/plot_bp3ve_demo.py . && echo "$0: see $dir/bp3ve_demo.png"
