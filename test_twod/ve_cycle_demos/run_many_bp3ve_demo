#!/bin/bash
#
# run_many_bp3ve_demo: the three-way BP3 viscoelastic comparison at a
# chosen resolution:
#
#   ve_g1     shear + normal tractions, gravity ON
#   ve_g0     shear + normal tractions, gravity OFF
#   ve_shear  shear only (sigma_n frozen), gravity ON, for contrast
#
# usage: run_many_bp3ve_demo [ds_km] [tmlist_yr] [stop_yr] [parallel]
#                            [ncore] [branch]
#        defaults           0.025    "15 45 200"  1500      0     4    1
#        branch +1 (default) normal-sense or -1 thrust; passed through
#              to run_bp3ve_demo, which stamps it into each run
#              directory and refuses to mix.  The thrust cases get a
#              _thrust suffix, so both branches can sit side by side
#              in one working directory.
#        ncore: cores per kernel generation (bp3_ve_kernels_par);
#              parallel=1 additionally runs 2 of the 3 cases at once,
#              so peak load is about 2 x ncore
#
# COST at 25 m (1600 patches): kernels are about half an hour on one
# core for the FIRST Maxwell time of a case, seconds for each further one
# (the sampled kernels depend on t/tau, not on tau, so the cache is
# shared by every Maxwell time in a run directory; see
# bp3_ve_kernels.py, "MAXWELL-TIME SCALING"), and the cycle runs are
# hours each.  Three savings are built in:
#   * ve_shear reuses ve_g1's SHEAR blocks (the same kernels; only
#     the normal family is dropped), by truncating the two-family
#     file instead of generating a third one;
#   * ve_g0 reuses ve_g1's ELASTIC reference (the elastic run knows
#     nothing about gravity, it is the same computation), including
#     its checkpoint, so it can be extended without being redone;
#   * every Maxwell time of one case shares one sampling pass, so
#     the tmlist is nearly free after its first entry (gravity on
#     and off are separate cases and each pays once).
# parallel=1 runs the remaining two cases concurrently.  Kernel
# generation is spread over `ncore` cores per file
# (bp3_ve_kernels_par): 25 m is about 0.5 h on one core and a few
# minutes on eight, once per case.  Since the batched evaluation
# path landed the CYCLE RUNS, not the kernels, dominate the wall
# clock at 25 m.
#
# SMOKE TEST FIRST: ./run_many_bp3ve_demo 0.1 "45" 1500
# exercises every path in a few minutes before you commit to 25 m.
#
ds=${1-0.025}
tms=${2-"15 45 200"}
stop=${3-1500}
par=${4-0}
ncore=${5-4}		# cores for kernel generation (the slow part)
branch=${6-1}		# +1 normal-sense, -1 thrust
# the two branches are different physics, so they get their own case
# directories and can sit side by side in one working directory
sfx=; [ "$branch" = "-1" ] && sfx=_thrust
g1=ve_g1$sfx; g0=ve_g0$sfx; vs=ve_shear$sfx
#extra="-imex"		# fine meshes with sigma coupling need it
extra=""
np=5

trunc_shear ()		# derive shear-only kernels from a two-family file
{
    src=$1; dst=$2
    [ -f "$src" ] || return 1
    [ -f "$dst" ] && return 0
    python3 - "$src" "$dst" <<'PY'
import sys
src, dst = sys.argv[1], sys.argv[2]
L = open(src).readlines()
h = [l for l in L if l.startswith("#")]
b = [l for l in L if not l.startswith("#")]
n, npr, nfam = (int(x) for x in b[0].split())
if nfam < 2:
    sys.exit(f"{src} is already shear only")
open(dst, "w").writelines(h + [f"{n} {npr} 1\n", b[1]]
                          + b[2:2 + (npr + 1)*n])
print(f"run_many_bp3ve_demo: derived {dst} from {src}")
PY
}

for tm in $tms;do
    echo "=== tM = $tm yr, ds = $ds km"
    # 1. gravity ON, shear + normal: this generates the kernels the
    #    other two cases reuse, so it goes first even in parallel mode
    ./run_bp3ve_demo $g1 "$tm" $stop 1 $ds 1 "$extra" $ncore $branch
    # 2. reuse: shear-only kernels by truncation, elastic reference by copy
    mkdir -p $vs $g0
    trunc_shear $g1/bp3_tm${tm}_g1n1.prony $vs/bp3_tm${tm}_g1n0.prony
    # the elastic reference knows nothing about gravity, so $g0 takes
    # $g1's whole elastic case: catalog, events, monitor, stations,
    # checkpoint and the stop-time stamp, so that $g0 can be extended
    # from it later just as $g1 can.  Refreshed when $g1's is newer,
    # which is what happens after $g1 itself has been extended.
    if [ -f $g1/cat_el.dat ] && { [ ! -f $g0/cat_el.dat ] || \
	    [ $g1/cat_el.dat -nt $g0/cat_el.dat ]; };then
	for f in cat_el.dat ev_el.dat mon_el.dat ckpt_el.bin stop_el.yr;do
	    [ -f $g1/$f ] && cp $g1/$f $g0/$f
	done
	rm -rf $g0/st_el
	[ -d $g1/st_el ] && cp -r $g1/st_el $g0/
	echo "$0: $g0 reuses $g1's elastic reference"
    fi
    # 3. the other two cases
    if [ "$par" = "1" ];then
	./run_bp3ve_demo $g0    "$tm" $stop 1 $ds 0 "$extra" $ncore $branch &
	./run_bp3ve_demo $vs "$tm" $stop 0 $ds 1 "$extra" $ncore $branch &
	wait
    else
	./run_bp3ve_demo $g0    "$tm" $stop 1 $ds 0 "$extra" $ncore $branch
	./run_bp3ve_demo $vs "$tm" $stop 0 $ds 1 "$extra" $ncore $branch
    fi
done
echo "=== summary"
for d in $g1 $g0 $vs;do
    [ -d $d ] && { echo "--- $d"; python3 plot_bp3ve_demo.py $d 2>&1 | \
	sed 's/^/    /'; }
done
echo "figures: ve_*/bp3ve_demo.png; station series in ve_*/st_*/"
