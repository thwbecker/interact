#!/bin/bash
#
# run_mn19_demo: reproduce the Miyake & Noda (EPS 2019) recurrence
# systematics with rsf_solve: a rate-weakening patch in a UNIFORM
# Maxwell medium (-ve_mode 1, single exact pole) under constant
# far-field loading.  Recurrence LENGTHENS with relaxation strength
# and DIVERGES at a critical t_c/t_load, below which the patch is
# permanently stuck (their ST class):
#     t_rec = alpha/(t_c/t_load - x_cr) + beta
# Reference values: their fully-dynamic 4.096R-periodic case has
# x_cr = 1.52; quasi-dynamic isolated strips give x_cr ~ 0.86 (about
# 1.1 with periodic patches); see test_twod/anti_plane/noda_mn_tests.md
# for the full replication.  This demo sweeps a few t_c values and
# fits the divergence; ~15 minutes total.
#
# usage: run_mn19_demo [outdir] [xlist]
#        defaults      mn19_demo "0 3.0 2.0 1.5 1.2 1.0 0.92"
#        (x = t_c/t_load; 0 = elastic reference; t_load = 2.1127 yr)
#
bindir=`cd ../../bin && pwd`
sdir=`pwd`
dir=${1-mn19_demo}
xlist=${2-"0 3.0 2.0 1.5 1.2 1.0 0.92"}
tload=2.112690
mkdir -p $dir && cd $dir
python3 $sdir/../anti_plane/gen_mn19.py 6 0.35 16 mn19 > gen.log
dcm=`awk '/pass:/{for(i=1;i<=NF;i++) if($i=="-dc") print $(i+1)}' gen.log`
common="-sigma_init 100e6 -f0 0.6 -v0 1e-9 -vpl 1e-9 -shear_modulus 30e9 \
 -s_wave_speed 3000 -state_law 1 -rtol 1e-4 -ts_rk_type 3bs -dt_monitor_yr 5 \
 -track_events -rsf_catalog -rsf_monitor_by_group 1 -vel_event 0.1 -dc $dcm"
for x in $xlist;do
    if [ "$x" = "0" ];then
	ve=""; out=cat_el.dat; stop=80
    else
	tm=`echo "$x * $tload" | bc -l`
	ve="-ve_mode 1 -ve_tmaxwell_yr $tm -ve_h_init 0"; out=cat_x$x.dat
	# recurrence is near-elastic at large x and only grows toward
	# the divergence, so short windows suffice except near x_cr
	stop=`echo "if ($x < 1.3) 200 else 70" | bc -l`
    fi
    rm -f rsf_catalog* rsf_events.dat rsf_monitor*
    echo "$0: x = $x (stop $stop yr)"
    $bindir/rsf_solve -geom_file mn19_geom.in -rsf_file mn19_rsf.dat \
      -rsf_ic_file mn19_ic.in $common -stop_time_yr $stop $ve \
      > run_x$x.log 2>&1
    cp rsf_catalog.g000.dat $out 2>/dev/null || echo "$0: x=$x NO CATALOG (stuck?)"
done
python3 $sdir/plot_mn19_demo.py . $tload && echo "$0: see $dir/mn19_demo.png"
