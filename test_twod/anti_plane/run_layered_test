#!/bin/bash
#
# step 7a layered antiplane checks: vertical screw fault segment in an
# elastic plate over a Maxwell substrate, exercised through the
# dip = -90 antiplane elements; validates the image machinery against
# the Rybicki (1971) elastic series and the Prony fit against the
# Nur and Mavko (1974) time-domain series
#
n=10
plate_h=2.0
t_M=1.0
n_img=60
# buried vertical fault, span [0.6, 2.4 - 1.0] within the plate; the
# driver uses the middle element as its source
makefault -z 0 -n $n -y -1.0  | gawk '{print($1,$2-0.4,$3,$4,-$5,$6,0,$8)}' > geom.in
# equal rigidity, then a weak and a stiff substrate
for g2fac in 1.0 0.25 3.0;do
    echo "g2/g1 = $g2fac"
    ve_layered_check $plate_h $t_M $g2fac $n_img
    echo
done

#
# surface profiles for plotting: surface-breaking fault through the
# full plate (depth extent D = H, delta = 1), all elements slipping by
# one unit; analytical series as lines, the numerical machinery (and
# the np = 6 Prony reconstruction for the time-dependent case) as
# points
#
makefault -z 0 -n $n -y -1.0  | gawk '{print($1,$2,$3,$4,-$5,$6,0,$8)}' > geom.in
ve_layered_check $plate_h $t_M 1.0 $n_img prof

cat <<EOF | gnuplot
set term post enh color solid 'Palatino-22'
set out 'layered_elastic.ps'
set xlabel 'distance from fault, x / plate thickness, H'
set ylabel 'displacement, u / fault slip, s'
set key top right
plot 'prof_elastic.dat' u 1:2  w l lw 2 t '{/Symbol G} = 1', \
     '' u 1:4  w l lw 2 t '{/Symbol G} = 0.75', \
     '' u 1:6  w l lw 2 t '{/Symbol G} = 0.5', \
     '' u 1:8  w l lw 3 t '{/Symbol G} = 0', \
     '' u 1:10 w l lw 2 t '{/Symbol G} = -0.5', \
     '' u 1:12 w l lw 2 t '{/Symbol G} = -1', \
     '' every 3 u 1:3  w p pt 7 ps .5 lc 1 not, \
     '' every 3 u 1:5  w p pt 7 ps .5 lc 2 not, \
     '' every 3 u 1:7  w p pt 7 ps .5 lc 3 not, \
     '' every 3 u 1:9  w p pt 7 ps .5 lc 4 not, \
     '' every 3 u 1:11 w p pt 7 ps .5 lc 5 not, \
     '' every 3 u 1:13 w p pt 7 ps .5 lc 6 not
set out 'layered_ve_disp.ps'
set ylabel 'displacement, u / fault slip, s'
plot 'prof_ve_disp.dat' u 1:2  w l lw 2 t "t' = 0", \
     '' u 1:4  w l lw 2 t "t' = 0.5", \
     '' u 1:6  w l lw 2 t "t' = 1", \
     '' u 1:8  w l lw 2 t "t' = 5", \
     '' u 1:10 w l lw 2 t "t' = 10", \
     '' every 3 u 1:3  w p pt 7 ps .5 lc 1 not, \
     '' every 3 u 1:5  w p pt 7 ps .5 lc 2 not, \
     '' every 3 u 1:7  w p pt 7 ps .5 lc 3 not, \
     '' every 3 u 1:9  w p pt 7 ps .5 lc 4 not, \
     '' every 3 u 1:11 w p pt 7 ps .5 lc 5 not
set out 'layered_ve_vel.ps'
set ylabel 'velocity, v {/Symbol t}_r / slip, s'
plot 'prof_ve_vel.dat' u 1:2  w l lw 2 t "t' = 0", \
     '' u 1:4  w l lw 2 t "t' = 0.5", \
     '' u 1:6  w l lw 2 t "t' = 1", \
     '' u 1:8  w l lw 2 t "t' = 5", \
     '' u 1:10 w l lw 2 t "t' = 10", \
     '' every 3 u 1:3  w p pt 7 ps .5 lc 1 not, \
     '' every 3 u 1:5  w p pt 7 ps .5 lc 2 not, \
     '' every 3 u 1:7  w p pt 7 ps .5 lc 3 not, \
     '' every 3 u 1:9  w p pt 7 ps .5 lc 4 not, \
     '' every 3 u 1:11 w p pt 7 ps .5 lc 5 not
EOF
for f in layered_elastic layered_ve_disp layered_ve_vel;do
    modifybb $f.ps 1
done
