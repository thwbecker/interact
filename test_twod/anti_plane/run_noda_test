#!/bin/bash
#
# Kato (2002) and Miyake & Noda (2019) replication tests for the 2-D
# antiplane visco-elastic machinery in rsf_solve, with independent
# exact-kernel integrators as arbiters and PNG figure rendering.
# Documentation: noda_mn_tests.md (these tests), README_ve_antiplane.md
# (all antiplane VE validations).  Runtime about 6-8 minutes.
#
# Gates:
#  (1) Kato 2002 ELASTIC replica, digitized Fig. 2 profiles, his
#      resolution (n=200): Tcy within 1 yr of 137.9 (his Table 1: 138;
#      the profile has NO tuned parameters)
#  (2) Kato 2002 VISCOELASTIC, tr = 1 yr, reduced n=80 problem:
#      rsf_solve -ve_mode 2 vs kato02_exact_chain.py (his hereditary
#      kernel integrated exactly via Erlang chains, no Prony fit, no
#      shared code): first two recurrence intervals within 8 percent,
#      and both shorter than 0.85 x elastic.  Kato's published Table 1
#      reports NO change; that null is NOT reproducible from his
#      equations.
#  (3) the explanation gate: the same chain with only image family A
#      (depths 2mh+z', i.e. the missing-family bug this project found
#      and fixed in the repo's own layered kernels) must give cycles
#      within 3 percent of ELASTIC at the same tr, which is exactly
#      Kato's Table 1 signature (his us and Fig. 4 match this variant
#      as well; see noda_mn_tests.md)
#  (4) M&N 2019 ELASTIC patch replica (Rc_EL/R = 0.35): t_rec matches
#      mn19_exact_chain.py; both near 12.4 yr
#  (5) M&N 2019 VISCOELASTIC, t_c/t_load = 1.0: rsf_solve -ve_mode 1
#      (stage-consistent sink) vs mn19_exact_chain.py (exact single
#      memory state): intervals within 3 percent (about 28 yr, the
#      2.2x lengthening of their Fig. 4b regime)
#  (6) M&N 2019 stuck transition: t_c/t_load = 0.8 produces exactly
#      one event and then remains locked (their ST class; their FD
#      critical value is 1.52, QD and the strip geometry lower it)
#
# Figures (rendered by plot_noda_test.py from these runs):
#  noda_kato02_test.png   recurrence vs tr with Kato's Table 1, and the
#                         family-A-only explanation
#  noda_mn19_test.png     t_rec vs t_c/t_load with the divergence fit
#                         and their FD curve for comparison

bindir=`cd ../../bin && pwd`
sdir=`pwd`
tdir=tmp_noda
mkdir -p $tdir; cd $tdir
fail=0

kcommon="-state_law 5 -v0 1e-6 -f0 0.6 -vpl 1.109083e-9 -shear_modulus 30e9 \
 -s_wave_speed 3270 -rtol 1e-4 -ts_rk_type 3bs -dt_monitor_yr 20 -track_events \
 -rsf_catalog -rsf_monitor_by_group 1 -vel_event 1e-2 -ts_max_steps 2000000000"

# ---- (1) Kato elastic, full resolution --------------------------------------
python3 $sdir/gen_kato02.py 0.1 20 kato02 > gen.log
$bindir/rsf_solve -geom_file kato02_geom.in -rsf_file kato02_rsf.dat \
  -rsf_ic_file kato02_ic.in -rsf_sigma_file kato02_sigma.in -dc 0.05 \
  -stop_time_yr 560 $kcommon > run_kel.log 2>&1
cp rsf_catalog.g000.dat cat_kato_el.dat
tcy=`grep -v '^#' cat_kato_el.dat | awk '$6>50{if(t)d=$2-t; t=$2} END{print d}'`
ok=`echo $tcy | awk '{print ($1>136.9 && $1<138.9)?1:0}'`
if [ "$ok" = "1" ];then
    echo "$0: (1) Kato 2002 elastic replica: Tcy $tcy yr (Kato: 138, no free parameters): PASS"
else
    echo "$0: (1) Kato 2002 elastic replica: Tcy '$tcy' yr outside [136.9,138.9]: FAIL"; fail=1
fi

# ---- (2,3) Kato VE vs exact chain, and the family-A explanation -------------
rm -f rsf_catalog* rsf_events.dat rsf_monitor*
python3 $sdir/gen_kato02.py 0.25 20 kato02 > gen.log
$bindir/rsf_solve -geom_file kato02_geom.in -rsf_file kato02_rsf.dat \
  -rsf_ic_file kato02_ic.in -rsf_sigma_file kato02_sigma.in -dc 0.1 \
  -stop_time_yr 350 $kcommon \
  -ve_mode 2 -ve_plate_h 20e3 -ve_tmaxwell_yr 0.5 -ve_h_init 0 > run_kve.log 2>&1
cp rsf_catalog.g000.dat cat_kato_ve.dat
python3 $sdir/kato02_exact_chain.py 0 1 350 80 0.1 exact   > chain_el.log 2>&1
python3 $sdir/kato02_exact_chain.py 200 1 350 80 0.1 exact > chain_ex.log 2>&1
python3 $sdir/kato02_exact_chain.py 10 1 480 80 0.1 single > chain_sf.log 2>&1
python3 - <<EOF || fail=1
import numpy as np,sys
def iv_cat(f,nmin=30):
    t=[]
    for l in open(f):
        if l.startswith("#"): continue
        c=l.split()
        if int(c[5])>nmin: t.append(float(c[1]))
    return np.diff(t)
def iv_chain(f):
    on=[]
    for l in open(f):
        if l.startswith(" onsets"):
            on=sorted(set(float(x) for x in l.split(":")[1].split()))
    return np.diff(on)
el=iv_chain("chain_el.log"); ex=iv_chain("chain_ex.log"); sf=iv_chain("chain_sf.log")
rs=iv_cat("cat_kato_ve.dat")
ok=True
nn=min(len(rs),len(ex),2)
dev=np.max(np.abs(rs[:nn]-ex[:nn])/(0.5*(rs[:nn]+ex[:nn])))
short=max(rs[:nn].max(),ex[:nn].max())/el[0]
ok2 = dev<0.08 and short<0.85
print("$0: (2) Kato VE tr=1: rsf %s vs chain %s yr, dev %.1f%%, Tcy/Tel %.2f: %s"%(
  np.round(rs[:nn],2),np.round(ex[:nn],2),100*dev,short,"PASS" if ok2 else "FAIL"))
sfdev=np.max(np.abs(sf[:2]-el[:2])/el[:2])
ok3 = sfdev<0.03
print("$0: (3) family-A-only kernel vs elastic: dev %.2f%% (Kato Table-1 signature): %s"%(
  100*sfdev,"PASS" if ok3 else "FAIL"))
sys.exit(0 if (ok2 and ok3) else 1)
EOF

# ---- (4,5,6) Miyake & Noda ---------------------------------------------------
mcommon="-sigma_init 100e6 -f0 0.6 -v0 1e-9 -vpl 1e-9 -shear_modulus 30e9 \
 -s_wave_speed 3000 -state_law 1 -rtol 1e-4 -ts_rk_type 3bs -dt_monitor_yr 5 \
 -track_events -rsf_catalog -rsf_monitor_by_group 1 -vel_event 0.1 \
 -ts_max_steps 2000000000"
python3 $sdir/gen_mn19.py 6 0.35 16 mn19 > genm.log
dcm=`awk '/pass:/{for(i=1;i<=NF;i++) if($i=="-dc") print $(i+1)}' genm.log`
rm -f rsf_catalog* rsf_events.dat rsf_monitor*
$bindir/rsf_solve -geom_file mn19_geom.in -rsf_file mn19_rsf.dat \
  -rsf_ic_file mn19_ic.in -dc $dcm $mcommon -stop_time_yr 60 > run_mel.log 2>&1
cp rsf_catalog.g000.dat cat_mn_el.dat
rm -f rsf_catalog* rsf_events.dat rsf_monitor*
$bindir/rsf_solve -geom_file mn19_geom.in -rsf_file mn19_rsf.dat \
  -rsf_ic_file mn19_ic.in -dc $dcm $mcommon -stop_time_yr 100 \
  -ve_mode 1 -ve_tmaxwell_yr 2.113386 -ve_h_init 0 > run_mve.log 2>&1
cp rsf_catalog.g000.dat cat_mn_ve.dat
rm -f rsf_catalog* rsf_events.dat rsf_monitor*
$bindir/rsf_solve -geom_file mn19_geom.in -rsf_file mn19_rsf.dat \
  -rsf_ic_file mn19_ic.in -dc $dcm $mcommon -stop_time_yr 100 \
  -ve_mode 1 -ve_tmaxwell_yr 1.690709 -ve_h_init 0 > run_mst.log 2>&1
cp rsf_catalog.g000.dat cat_mn_st.dat
python3 $sdir/mn19_exact_chain.py 2.113386 100 6 0.35 16 > chain_mn.log 2>&1
python3 - <<EOF || fail=1
import numpy as np,sys
def iv_cat(f,nmin=30):
    t=[]
    for l in open(f):
        if l.startswith("#"): continue
        c=l.split()
        if int(c[5])>nmin: t.append(float(c[1]))
    return np.array(t)
def on_chain(f):
    on=[]
    for l in open(f):
        if l.startswith(" onsets"):
            on=sorted(set(float(x) for x in l.split(":")[1].split()))
    return np.array(on)
tel=iv_cat("cat_mn_el.dat"); iel=np.diff(tel)
ok4 = len(iel)>2 and abs(iel[-1]-12.4)<0.6
print("$0: (4) M&N elastic (Rc/R=0.35): t_rec %.2f yr (target 12.4): %s"%(
  iel[-1] if len(iel) else -1,"PASS" if ok4 else "FAIL"))
tve=iv_cat("cat_mn_ve.dat"); ive=np.diff(tve)
och=on_chain("chain_mn.log"); ich=np.diff(och)
nn=min(len(ive),len(ich),3)
dev=np.max(np.abs(ive[:nn]-ich[:nn])/ich[:nn]) if nn else 1.0
ok5 = nn>=2 and dev<0.03
print("$0: (5) M&N t_c/t_load=1: rsf %s vs chain %s yr, dev %.1f%%: %s"%(
  np.round(ive[:nn],2),np.round(ich[:nn],2),100*dev,"PASS" if ok5 else "FAIL"))
tst=iv_cat("cat_mn_st.dat")
ok6 = len(tst)==1
print("$0: (6) M&N t_c/t_load=0.8: %d event(s) in 100 yr (stuck, ST class): %s"%(
  len(tst),"PASS" if ok6 else "FAIL"))
sys.exit(0 if (ok4 and ok5 and ok6) else 1)
EOF

# ---- figures -----------------------------------------------------------------
python3 $sdir/plot_noda_test.py && echo "$0: figures: noda_kato02_test.png noda_mn19_test.png"

cd ..
if [ $fail -eq 0 ];then
    echo "$0: all gates PASS"
else
    echo "$0: FAILURES, see above"; exit 1
fi
